{
  "name": "tro-ly-cdn",
  "version": "0.1.0",
  "description": "Trợ lý AI mã nguồn mở chạy 24/7 trên máy bạn hoặc VPS — bắt đầu với trợ lý Zalo cá nhân",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextstepacademyvietnam/tro-ly-cdn.git"
  },
  "homepage": "https://github.com/nextstepacademyvietnam/tro-ly-cdn#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node launcher.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "start:direct": "node dist/server/index.js",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/sdk": "^1.7.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "image-size": "^2.1.0",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0",
    "zca-js": "2.1.2"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
